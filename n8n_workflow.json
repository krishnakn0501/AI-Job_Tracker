[
  {
    "name": "Resume Generator",
    "nodes": [
      {
        "name": "Webhook",
        "type": "n8n-nodes-base.webhook",
        "parameters": {
          "httpMethod": "POST",
          "path": "generate-resume",
          "authentication": "headerAuth",
          "responseMode": "onReceived",
          "responseData": "allEntries"
        }
      },
      {
        "name": "Fetch Resume Base",
        "type": "n8n-nodes-base.httpRequest",
        "parameters": {
          "method": "GET",
          "url": "={{ $env.APP_URL }}/api/resume-base"
        }
      },
      {
        "name": "Call Claude API",
        "type": "n8n-nodes-base.httpRequest",
        "parameters": {
          "method": "POST",
          "url": "https://api.anthropic.com/v1/messages",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              { "name": "x-api-key", "value": "={{ $env.ANTHROPIC_KEY }}" },
              { "name": "anthropic-version", "value": "2023-06-01" },
              { "name": "Content-Type", "value": "application/json" }
            ]
          },
          "sendBody": true,
          "bodyParameters": {
            "parameters": [
              { "name": "model", "value": "claude-sonnet-4-20250514" },
              { "name": "max_tokens", "value": 2000 },
              { "name": "system", "value": "You are a professional resume writer. Return ONLY valid JSON matching the requested schema. No markdown, no explanation, no code blocks. Start your response with { and end with }." },
              { "name": "messages", "value": "=[{ \"role\": \"user\", \"content\": \"Customise this resume for the job description below.\\n\\nBASE RESUME:\\n\" + JSON.stringify($node[\"Fetch Resume Base\"].json) + \"\\n\\nJOB DESCRIPTION:\\n\" + $json.body.jd_text + \"\\n\\nReturn this exact JSON structure:\\n{\\\"summary\\\": \\\"2-3 sentence tailored summary for this specific role\\\",\\\"top_skills\\\": [\\\"skill1\\\",\\\"skill2\\\",\\\"skill3\\\",\\\"skill4\\\",\\\"skill5\\\",\\\"skill6\\\",\\\"skill7\\\",\\\"skill8\\\"],\\\"experience\\\": [{\\\"company\\\":\\\"exact company name from resume\\\",\\\"role\\\":\\\"exact role from resume\\\",\\\"duration\\\":\\\"exact duration from resume\\\",\\\"bullets\\\":[\\\"quantified achievement tailored to JD\\\",\\\"another bullet\\\",\\\"third bullet\\\"]}],\\\"ats_keywords\\\":[\\\"keyword1\\\",\\\"keyword2\\\",\\\"keyword3\\\",\\\"keyword4\\\",\\\"keyword5\\\",\\\"keyword6\\\"]}\"}]" }
            ]
          }
        }
      },
      {
        "name": "Parse Response",
        "type": "n8n-nodes-base.code",
        "parameters": {
          "jsCode": "const text = $input.first().json.content[0].text;\nconst clean = text.replace(/```json|```/g, '').trim();\nconst parsed = JSON.parse(clean);\nreturn [{ json: { ...parsed, application_id: $('Webhook').first().json.body.application_id } }];"
        }
      },
      {
        "name": "Generate DOCX",
        "type": "n8n-nodes-base.httpRequest",
        "parameters": {
          "method": "POST",
          "url": "={{ $env.APP_URL }}/api/generate-docx",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              { "name": "x-api-key", "value": "={{ $env.N8N_API_KEY }}" },
              { "name": "Content-Type", "value": "application/json" }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify($json) }}"
        }
      },
      {
        "name": "Update Application",
        "type": "n8n-nodes-base.httpRequest",
        "parameters": {
          "method": "PATCH",
          "url": "={{ $env.APP_URL }}/api/applications/{{ $json.application_id }}",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              { "name": "Content-Type", "value": "application/json" }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={\"resumeStatus\":\"ready\",\"resumePath\":\"{{ $json.file_path }}\",\"claudeOutput\":{{ JSON.stringify($node['Parse Response'].json) }}}"
        }
      }
    ],
    "connections": {
      "Webhook": {
        "main": [
          [
            { "node": "Fetch Resume Base", "type": "main", "index": 0 }
          ]
        ]
      },
      "Fetch Resume Base": {
        "main": [
          [
            { "node": "Call Claude API", "type": "main", "index": 0 }
          ]
        ]
      },
      "Call Claude API": {
        "main": [
          [
            { "node": "Parse Response", "type": "main", "index": 0 }
          ]
        ]
      },
      "Parse Response": {
        "main": [
          [
            { "node": "Generate DOCX", "type": "main", "index": 0 }
          ]
        ]
      },
      "Generate DOCX": {
        "main": [
          [
            { "node": "Update Application", "type": "main", "index": 0 }
          ]
        ]
      }
    },
    "settings": {
      "executionOrder": "v1"
    }
  },
  {
    "name": "Daily Reminders",
    "nodes": [
      {
        "name": "Schedule",
        "type": "n8n-nodes-base.scheduleTrigger",
        "parameters": {
          "rule": {
            "interval": [{ "field": "hours", "hoursInterval": 24 }]
          },
          "triggerAtHour": 9
        }
      },
      {
        "name": "Get Reminders",
        "type": "n8n-nodes-base.httpRequest",
        "parameters": {
          "method": "GET",
          "url": "={{ $env.APP_URL }}/api/reminders"
        }
      },
      {
        "name": "Has Reminders",
        "type": "n8n-nodes-base.if",
        "parameters": {
          "conditions": {
            "number": [{ "value1": "={{ $json.length }}", "operation": "larger", "value2": 0 }]
          }
        }
      },
      {
        "name": "Build Email",
        "type": "n8n-nodes-base.code",
        "parameters": {
          "jsCode": "const items = $input.all().map(i => i.json);\nconst rows = items.map(r => `<tr><td style=\"padding:8px;border:1px solid #e2e8f0\">${r.company}</td><td style=\"padding:8px;border:1px solid #e2e8f0\">${r.role}</td><td style=\"padding:8px;border:1px solid #e2e8f0\">${r.status}</td><td style=\"padding:8px;border:1px solid #e2e8f0\">${r.type === 'interview' ? 'Interview tomorrow' : 'Follow-up today'}</td></tr>`).join('');\nconst html = `<div style=\"font-family:Arial,sans-serif;max-width:600px\"><h2 style=\"color:#1E3A5F\">JobTrack — ${items.length} action${items.length>1?'s':''} due</h2><table style=\"border-collapse:collapse;width:100%\"><thead><tr style=\"background:#1E3A5F;color:white\"><th style=\"padding:8px;text-align:left\">Company</th><th style=\"padding:8px;text-align:left\">Role</th><th style=\"padding:8px;text-align:left\">Status</th><th style=\"padding:8px;text-align:left\">Action</th></tr></thead><tbody>${rows}</tbody></table><br><a href=\"${ $env.APP_URL }\" style=\"color:#2E86AB\">Open JobTrack →</a></div>`;\nreturn [{ json: { html, subject: `${items.length} action${items.length>1?'s':''} due today — JobTrack`, count: items.length } }];"
        }
      },
      {
        "name": "Send Email",
        "type": "n8n-nodes-base.emailSend",
        "parameters": {
          "fromEmail": "={{ $env.USER_EMAIL }}",
          "toEmail": "={{ $env.USER_EMAIL }}",
          "subject": "={{ $json.subject }}",
          "html": "={{ $json.html }}"
        }
      }
    ],
    "connections": {
      "Schedule": {
        "main": [
          [
            { "node": "Get Reminders", "type": "main", "index": 0 }
          ]
        ]
      },
      "Get Reminders": {
        "main": [
          [
            { "node": "Has Reminders", "type": "main", "index": 0 }
          ]
        ]
      },
      "Has Reminders": {
        "main": [
          [
            { "node": "Build Email", "type": "main", "index": 0 }
          ],
          []
        ]
      },
      "Build Email": {
        "main": [
          [
            { "node": "Send Email", "type": "main", "index": 0 }
          ]
        ]
      }
    },
    "settings": {
      "executionOrder": "v1"
    }
  }
]
